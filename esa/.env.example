# Шаблон prod-env для ЕСА (единый вход экосистемы Малмыжа).
# Реальные значения — в prod-env бокса, НЕ в репозитории (правило #008).
# Скопируй, заполни и положи в EnvironmentFile= systemd-юнита.

# --- База (обязательна) ---
ESA_DATABASE_URL=postgresql://esa:<пароль>@127.0.0.1:5432/esa

# --- Идентификация провайдера ---
# issuer НЕ меняется при переезде сервиса: та же строка стоит у всех клиентов.
ESA_ISSUER=https://xn--b1ae3a1a.xn--80adkdyec4j.xn--p1ai
# Приватный RS256-ключ — файл вне репозитория (потеря = перевыпуск для экосистемы).
ESA_PRIVATE_KEY_FILE=/etc/setka/radar_id_rs256.pem

# --- Сессии ---
# ВАЖНО: значение должно совпадать со старым SETKA_WEB_SECRET, иначе живые
# сессии перестанут работать.
ESA_WEB_SECRET=<длинный-секрет>
# Общий вход на всю зону .вмалмыже.рф (punycode).
ESA_SESSION_COOKIE_DOMAIN=.xn--80adkdyec4j.xn--p1ai
ESA_SESSION_COOKIE_SECURE=1
ESA_SESSION_COOKIE=setka_session

# --- Внутренний API для портала ---
# Без токена /internal/* закрыт целиком (404).
ESA_INTERNAL_TOKEN=<секрет-внутреннего-api>

# --- Регистрация ---
# Пусто → регистрация открыта; задан → нужен инвайт-код.
ESA_INVITE_CODE=
# Логины владельца (зарезервированы, не регистрируются).
ESA_OWNER_LOGINS=valstan

# --- ВК-вход ---
ESA_VK_APP_ID=
# ESA_VK_REDIRECT_URI=https://xn--b1ae3a1a.xn--80adkdyec4j.xn--p1ai/auth/vk/callback

# --- Прочее ---
# ESA_ACCESS_TOKEN_TTL=600
# ESA_AUTH_CODE_TTL=60
# ESA_REFRESH_TTL_DAYS=30
# ESA_DEFAULT_LANDING=/services
# ESA_RATE_PER_MIN=30
# ESA_RATE_PER_DAY=2000
# ESA_STATIC_VERSION=1
# ESA_LOG_LEVEL=INFO
# ESA_DISABLED=0
