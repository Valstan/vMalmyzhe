# Generated SEO artefacts
public/robots.txt
public/sitemap*.xml

# Generated font files with content hashes (source in src/fonts/)
public/fonts/*.[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9].ttf

