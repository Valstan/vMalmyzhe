# ─────────────────────────────────────────────────────────────────────────────
# вМалмыже.РФ — пример переменных окружения.
#
# ⚠️ Это ШАБЛОН. Реальные значения НЕ коммитим (pool #008 «секреты вне репо»).
#   • Локально:  скопировать в web/.env и подставить значения (web/.env в .gitignore).
#   • На проде:  секреты живут в /etc/vmalmyzhe/vmalmyzhe.env (root:0640) и
#                подключаются systemd-юнитом через EnvironmentFile=, НЕ в дереве репо.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Локально (Windows + системный Postgres): postgres/postgres.
DATABASE_URI=

# Payload auth secret (шифрует JWT). На проде — длинная случайная строка.
PAYLOAD_SECRET=

# Публичный URL сервера (без хвостового слэша).
NEXT_PUBLIC_SERVER_URL=https://вмалмыже.рф

# Порт приложения. Прод-юнит читает PORT из /etc/vmalmyzhe/vmalmyzhe.env;
# Next standalone (server.js) уважает PORT. Локально по умолчанию тоже 3004.
PORT=3004

# ─── SMTP-relay для исходящих писем (опционально) ─────────────────────────────
# Пока SMTP_HOST пуст — email-адаптер в payload.config НЕ подключается, письма
# пишутся в консоль; сборка/типы при этом зелёные. Чтобы письма реально уходили,
# заполнить все SMTP_* (на проде — в /etc/vmalmyzhe/vmalmyzhe.env).
#   port 465 → secure=true (implicit TLS), 587/2525 → secure=false (STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@вмалмыже.рф
# SMTP_FROM_NAME=вМалмыже.РФ
# SMTP_SECURE=false

# Прод (IDN вмалмыже.рф → punycode xn--…, точное значение уточнить при настройке DNS/nginx):
# NEXT_PUBLIC_SERVER_URL=https://xn--<punycode>.xn--p1ai
