# вМалмыже.РФ — systemd-юнит прод-сервера (Next standalone).
# Артефакт собирается в CI и распаковывается в releases/<sha>; current → симлинк.
# Установка на сервере:
#   sudo cp deploy/vmalmyzhe.service /etc/systemd/system/vmalmyzhe.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now vmalmyzhe
[Unit]
Description=vMalmyzhe (Next.js standalone)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=valstan
WorkingDirectory=/home/valstan/vmalmyzhe/current
# Секреты (DATABASE_URI, PAYLOAD_SECRET, PORT, MEDIA_DIR, …) — вне репо (pool #008).
EnvironmentFile=/etc/vmalmyzhe/vmalmyzhe.env
# Keep-alive длиннее, чем у любого разумного прокси-пула (G234): при дефолтных
# 5 с Node закрывает сокет, который прокси считает живым, и не-идемпотентный POST
# отвечает 502 при пустых логах приложения. Сегодня гонка не воспроизводима —
# nginx проксирует без `upstream{keepalive}`, пул не держится; это страховка на
# случай, когда пул появится. `headersTimeout` Next-standalone наружу не отдаёт,
# он остаётся 60 000 мс и фактически ограничивает idle сверху — то есть пул
# прокси должен быть короче 60 с.
Environment=KEEP_ALIVE_TIMEOUT=65000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
# Память: на малом боксе ограничиваем рантайм, чтобы не уронить postgres.
MemoryMax=1024M
# Лёгкая защита
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
